<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Contoso Online Portal</title>
<style>:root{color-scheme:dark;--bg:#060914;--card:#111827dd;--line:#26334c;--text:#e5e7eb;--muted:#94a3b8;--cyan:#22d3ee;--green:#34d399;--red:#fb7185}*{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,sans-serif;background:radial-gradient(circle at 10% 5%,#164e63 0,transparent 32%),radial-gradient(circle at 90% 90%,#312e81 0,transparent 35%),var(--bg);color:var(--text);min-height:100vh}main{max-width:1050px;margin:auto;padding:55px 20px}header{display:flex;justify-content:space-between;gap:20px;align-items:start;flex-wrap:wrap}h1{font-size:clamp(38px,6vw,66px);letter-spacing:-.05em;margin:12px 0}.cyan{color:var(--cyan)}.pill{border:1px solid #065f46;background:#052e16;color:#86efac;border-radius:999px;padding:8px 13px;font-weight:700}.meta,.layout{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:14px;margin:24px 0}.card{background:var(--card);border:1px solid var(--line);border-radius:17px;padding:20px;box-shadow:0 18px 55px #0005}.label{color:var(--muted);text-transform:uppercase;letter-spacing:.12em;font-size:11px;font-weight:800}.value{font-size:18px;font-weight:750;margin-top:8px}.layout{grid-template-columns:minmax(280px,.8fr) minmax(320px,1.2fr)}label{display:block;color:var(--muted);margin:12px 0 6px}input,textarea{width:100%;background:#070b16;border:1px solid var(--line);color:var(--text);border-radius:10px;padding:12px;font:inherit}textarea{height:100px;resize:vertical}button{margin-top:14px;border:0;border-radius:10px;padding:12px 18px;background:linear-gradient(135deg,#0891b2,#4f46e5);color:white;font-weight:800;cursor:pointer}.message{border-bottom:1px solid var(--line);padding:13px 0}.message:last-child{border:0}.message small{color:var(--muted)}#notice{min-height:24px;margin-top:12px}.error{color:var(--red)}@media(max-width:720px){.layout{grid-template-columns:1fr}}</style></head>
<body><main><header><div><div class="pill">WAF-PROTECTED ONLINE LANDING ZONE</div><h1>Contoso <span class="cyan">Customer Portal</span></h1><p style="color:var(--muted)">Submit a message through WAF → zonal frontend → internal API load balancer → private Azure SQL.</p></div></header>
<section class="meta"><div class="card"><div class="label">Frontend zone</div><div class="value">Zone ${zone}</div></div><div class="card"><div class="label">Frontend VM</div><div class="value">${vm_name}</div></div><div class="card"><div class="label">Private IP</div><div class="value">${private_ip}</div></div><div class="card"><div class="label">Region</div><div class="value">${region}</div></div><div class="card"><div class="label">API DNS</div><div class="value">api.online.contoso.internal</div></div><div class="card"><div class="label">Database</div><div class="value" id="db">Checking…</div></div></section>
<section class="layout"><div class="card"><h2>Add a customer message</h2><form id="form"><label>Name</label><input id="name" required minlength="2" maxlength="60" placeholder="Your name"><label>Message</label><textarea id="message" required minlength="3" maxlength="240" placeholder="Enter a short message"></textarea><button>Validate & save to SQL</button><div id="notice"></div></form></div><div class="card"><h2>Messages from the database</h2><div id="messages">Loading…</div></div></section></main>
<script>const notice=document.querySelector('#notice'),list=document.querySelector('#messages');async function load(){try{const h=await fetch('/api/health').then(r=>r.json());document.querySelector('#db').textContent=h.database+' via '+h.api_vm+' / Zone '+h.api_zone;const rows=await fetch('/api/messages').then(r=>r.json());list.innerHTML=rows.map(x=>'<div class="message"><strong>'+escapeHtml(x.name)+'</strong><p>'+escapeHtml(x.message)+'</p><small>#'+x.id+' · API Zone '+x.api_zone+' · '+x.created_at+'Z</small></div>').join('')||'No messages yet.'}catch(e){list.innerHTML='<span class="error">API or database unavailable.</span>'}}function escapeHtml(s){return String(s).replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]))}document.querySelector('#form').addEventListener('submit',async e=>{e.preventDefault();notice.textContent='Validating and saving…';notice.className='';const r=await fetch('/api/messages',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:document.querySelector('#name').value,message:document.querySelector('#message').value})});const b=await r.json();if(!r.ok){notice.textContent=b.error||'Request failed';notice.className='error';return}notice.textContent='Saved record #'+b.id+' by API '+b.served_by+' in Zone '+b.api_zone;e.target.reset();load()});load();setInterval(load,15000)</script></body></html>
